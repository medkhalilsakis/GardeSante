# ============================================================
# GARDESANTE - VARIABLES D'ENVIRONNEMENT
# Copier ce fichier en .env et adapter les valeurs
# ============================================================

# Environnement
NODE_ENV=development
PORT=5000

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hospital_guard
DB_USER=hospital_user
DB_PASSWORD=password123

# JWT
JWT_SECRET=gardesante_jwt_secret_CHANGE_IN_PRODUCTION_min32chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=gardesante_refresh_secret_CHANGE_IN_PRODUCTION_min32chars
JWT_REFRESH_EXPIRES_IN=7d

# CORS (URL du frontend)
CORS_ORIGIN=http://localhost:5173

# Seed automatique au démarrage (true en dev seulement)
SEED_DB=true

# Logs
LOG_LEVEL=debug
